# Dockerfile for SCG NGINX demo containers
# Builds only the gateway binary from the SCG workspace.
#
# Build context must be the parent directory that contains the sibling
# checkouts (SCG/, ale-frame/, SCG-deploy-methods/) — gateway depends on
# ale-frame.

# Stage 1: Build the gateway binary
FROM rust:1.89-bookworm AS builder

RUN apt-get update && apt-get install -y \
    libssl-dev \
    pkg-config \
    protobuf-compiler \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /build

# Copy only what's needed for the gateway build
COPY SCG/ ./SCG/
COPY ale-frame/ ./ale-frame/

WORKDIR /build/SCG
# --features dev: the demo entrypoint generates an unsigned single-file --config
# at runtime, which a default (production) gateway build rejects (signed
# --config-dir only).
# Redirect the private ale-frame git dependency to the sibling copied into the
# build context — works offline and without GitHub credentials.
RUN printf '\n[patch."https://github.com/TianTomascsik/ale-frame.git"]\nale-frame = { path = "../ale-frame" }\n' >> Cargo.toml
RUN cargo build --release -p gateway --features dev

# Stage 2: Runtime image
FROM debian:bookworm-slim

RUN apt-get update && apt-get install -y \
    libssl3 \
    ca-certificates \
    iproute2 \
    iptables \
    kmod \
    socat \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Copy gateway binary
COPY --from=builder /build/SCG/target/release/gateway /usr/local/bin/gateway

# Entrypoint scripts are bind-mounted via docker-compose volumes
RUN mkdir -p /results /etc/gateway

WORKDIR /app
