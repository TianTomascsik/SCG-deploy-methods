# Dockerfile for SCG switchable demo (HTTP/HTTPS toggle)
# Builds the gateway binary and includes the Python control server.
#
# Build context must be the parent directory that contains the sibling
# checkouts (SCG/, ale-frame/, SCG-deploy-methods/).

# Stage 1: Build the gateway binary
FROM rust:1.89-bookworm AS builder

RUN apt-get update && apt-get install -y \
    libssl-dev \
    pkg-config \
    protobuf-compiler \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /build

COPY SCG/ ./SCG/
COPY ale-frame/ ./ale-frame/

WORKDIR /build/SCG
# --features dev: the entrypoint generates an unsigned single-file --config at
# runtime, which a default (production) gateway build rejects (signed
# --config-dir only).
RUN cargo build --release -p gateway --features dev

# Stage 2: Runtime image
FROM debian:bookworm-slim

RUN apt-get update && apt-get install -y \
    libssl3 \
    ca-certificates \
    iproute2 \
    iptables \
    socat \
    python3 \
    procps \
    && rm -rf /var/lib/apt/lists/*

# Copy gateway binary
COPY --from=builder /build/SCG/target/release/gateway /usr/local/bin/gateway

# Copy control server and entrypoint
COPY SCG-deploy-methods/container/control_server.py /app/control_server.py
COPY SCG-deploy-methods/container/entrypoint_switchable.sh /app/entrypoint.sh
RUN chmod +x /app/entrypoint.sh

RUN mkdir -p /etc/gateway

WORKDIR /app
ENTRYPOINT ["/app/entrypoint.sh"]
