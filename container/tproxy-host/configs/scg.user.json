{
  "gateway": {
    "gateway_id": "scg-host-tproxy",
    "config_id": "host-transparent-proxy",
    "environment": "production"
  },
  "apps": [],
  "connections": [
    {
      "connection_id": "secure-4200",
      "description": "Local-egress TLS interception for the HTTP service on port 4200. Local clients connect to https://localhost:4200; iptables redirects that traffic to the gateway listening on port 4201, which terminates TLS and forwards plain HTTP to the backend on 127.0.0.1:4200.",
      "traffic_class": "normal",
      "transparent": false,
      "application_protocol": "raw_tcp",
      "transport": {
        "type": "stream",
        "protocol": "tcp"
      },
      "protection": {
        "role": "server",
        "mode": "full",
        "profile_ref": "tls-server-default"
      },
      "ingress": {
        "endpoint": {
          "ip": "::",
          "port": 4201
        },
        "intercept": {
          "mode": "egress_redirect",
          "match_dports": "4200",
          "match_dst": ["127.0.0.1"]
        }
      },
      "paths": [
        {
          "path_id": "path-backend",
          "priority": 0,
          "egress": {
            "endpoint": {
              "host": "127.0.0.1",
              "port": 4200
            }
          }
        }
      ]
    }
  ]
}
